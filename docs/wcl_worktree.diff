     --epochs 5 --eval-every 2 --abort-on-flat --flat-patience 3 \
@@ -110,6 +114,9 @@ if [ "$DRY" != "1" ]; then
     exit 2
   fi
 fi
+else
+  beat "4/6 烟测：SKIP_SMOKE=1，跳过（已完成 outputs/${CAMP}_smoke）"
+fi
 
 # ---------------------------------------------------------------- 5) campaign
 beat "5/6 campaign：$TIERS（幂等，已完成的 run 自动跳过）"
